# Notes default configuration — copied to notes.ini on
# first launch. An empty db_dir means the default database location
# (~/.local/share/notes/notes.db).
[notes]
db_dir=
code_copy_button=1
code_line_numbers=1
native_menubar=1
sidebar_counts=0
image_viewer=
db_integrity_check=1
search_win_w=538
search_win_h=299
first_line_title=1
compact_editor_toolbar=1
editor_win_w=640
editor_win_h=509
touch_assist=0
list_columns=path:0,title:1,modified:1,created:0
action_columns=done:1,action:1,due:1
list_autofit=1
statusbar_db_path=0
statusbar_note_id=0
show_done_actions=1
list_density_comfortable=1
bold_list_titles=1
